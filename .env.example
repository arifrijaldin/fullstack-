# ==============================================================================
# HOTEL AUTOMATION & RECONCILIATION PLATFORM (.env.example)
# Rename this file to .env and fill in your actual environment parameters.
# NEVER commit the real .env file into public version control.
# ==============================================================================

# Application Environment (development / staging / production)
APP_ENV=production
HOTEL_NAME="Grand Nusantara Hotel & Resort"

# Database Configuration (Legacy Sybase SQL Anywhere / ODBC)
DB_DRIVER="{SQL Anywhere 17}"
DB_SERVER="db_hotel_prod"
DB_HOST="192.168.1.100"
DB_PORT=2639
DB_USER="db_operator"
DB_PASSWORD="your_secure_db_password_here"

# Cloud PMS Portal Scraping Credentials
CLOUD_PMS_LOGIN_URL="https://pms.hotel-cloud-provider.example/login"
CLOUD_PMS_USERNAME="fo_operator@hotel-example.com"
CLOUD_PMS_PASSWORD="your_secure_pms_password_here"
SCRAPER_HEADLESS=true
SCRAPER_SYNC_INTERVAL_SECONDS=600

# Mailbox & Voucher Watcher Directories (Thunderbird / Local Maildir)
MAILBOX_DIRECTORY="C:/HotelSystem/Mailbox/ImapMail/Reservations"
VOUCHER_STORAGE_DIR="C:/HotelSystem/Vouchers/Archive"
QUARANTINE_STORAGE_DIR="C:/HotelSystem/Vouchers/Quarantine"

# Internal Micro-Service API
SERVER_HOST="127.0.0.1"
SERVER_PORT=8085
